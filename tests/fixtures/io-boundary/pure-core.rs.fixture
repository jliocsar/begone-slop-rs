//! A "pure" core module.

use std::net::SocketAddr;
use std::process::ExitCode;
use std::env::consts::OS;

use crate::shell::disk;

fn parse_address(text: &str) -> Option<SocketAddr> {
    text.parse().ok()
}

fn status(failed: Failed) -> ExitCode {
    ExitCode::FAILURE
}

fn sneaky() -> String {
    let text = format!("{}", std::fs::read_to_string("secrets").unwrap_or_default()); //~ io-boundary, no-work-in-format-args
    let stamp = std::time::UNIX_EPOCH.elapsed();

    std::os::unix::fs::symlink("a", "b"); //~ io-boundary

    let token = uuid::Uuid::new_v4(); //~ io-boundary
    let out = tokio::io::stdout(); //~ io-boundary

    dbg!(&text); //~ io-boundary

    let laundered = disk::read_to_string("x");
    let more = crate::shell::load_config();

    text
}
