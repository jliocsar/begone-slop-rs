//@ path: src/main.rs
//! julio's slop example: what the syntax rules catch in it.

fn main() -> Result<(), Box<dyn std::error::Error + 'static>> { //~ no-needless-main-result
    let _x = |&y: &i32| -> bool { //~ no-abbreviations
        y & 0b1010_1010u8 as i32 ^ !0xFFu32 >> 1 //~ parenthesize-mixed-operators
            == 0 && *(&y) <= 42 || y % 3 != 0
    };
    let _f = |z: &_| { //~ no-abbreviations, padding
        **(&&z) * *(&*z) ^ *(&0xFF_u8) as i32 //~ parenthesize-mixed-operators
    };
    println!(r#"$#@! {} {:?} {:?}"#, //~ padding
        (1..=10).filter(|&n| n % 2 != 0) //~ no-work-in-format-args
        .map(|&n| *(&n) * *(&n)).sum::<i32>() & 0xff,
        Some(vec![1, 2, 3]), 'a');
    Ok(()) //~ padding
}
