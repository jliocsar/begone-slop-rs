//! prefer-match loopholes, and its conflict with no-stringly-match.

fn yoda(mode: u8) -> u8 {
    if 1 == mode {
        3
    } else if 2 == mode {
        1
    } else if 3 == mode {
        0
    } else {
        2
    }
}

fn if_let_chain(mode: Mode) -> u8 {
    if let Mode::Fast = mode {
        3
    } else if let Mode::Slow = mode {
        1
    } else if let Mode::Off = mode {
        0
    } else {
        2
    }
}

fn keybindings(key: Key, up: Key, down: Key, left: Key) -> Move {
    if key == up { //~ prefer-match
        Move::Up
    } else if key == down {
        Move::Down
    } else if key == left {
        Move::Left
    } else {
        Move::Stay
    }
}

fn command(name: &str) -> u8 {
    if name == "open" { //~ prefer-match
        1
    } else if name == "close" {
        2
    } else if name == "quit" {
        3
    } else {
        0
    }
}

fn command_as_match(name: &str) -> u8 {
    match name {
        "open" => 1,
        "close" => 2,
        "quit" => 3,
        _ => 0,
    }
}
