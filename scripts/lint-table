#!/usr/bin/env bash
# Regenerates src/lints/known.rs from the toolchain's own lint list (`clippy-driver -W help`):
# every lint rustc and clippy know, with its default level, and every lint group. preset-drift
# resolves `[lints]` tables with it, so run this again after a toolchain bump.
set -euo pipefail
cd "$(dirname "$0")/.."

version="$(clippy-driver --version)"
output=src/lints/known.rs

clippy-driver -W help 2>/dev/null | awk -v version="$version" '
    function name(raw) { gsub("-", "_", raw); return raw }
    /^Lint checks provided by rustc:/ { section = "lints"; next }
    /^Lint checks loaded by this crate:/ { section = "lints"; next }
    /^Lint groups provided by rustc:/ { section = "groups"; next }
    /^Lint groups loaded by this crate:/ { section = "groups"; next }
    section == "lints" && NF >= 2 && $1 != "name" && $1 != "----" && ($2 == "allow" || $2 == "warn" || $2 == "deny" || $2 == "forbid") {
        levels[++lint_count] = sprintf("    (\"%s\", Level::%s),", name($1), toupper(substr($2, 1, 1)) substr($2, 2))
    }
    section == "groups" && NF >= 2 && $1 != "name" && $1 != "----" && $1 != "warnings" {
        group = name($1)
        $1 = ""
        members = $0
        gsub(/^ +/, "", members)
        count = split(members, parts, /, */)
        line = sprintf("    (\n        \"%s\",\n        &[\n", group)
        for (i = 1; i <= count; i++) {
            line = line sprintf("            \"%s\",\n", name(parts[i]))
        }
        groups[++group_count] = line "        ],\n    ),"
    }
    END {
        print "//! Every lint rustc and clippy know, with its default level, and every lint group."
        print "//!"
        print "//! Generated by `scripts/lint-table` from `clippy-driver -W help`; run the script again"
        print "//! after a toolchain bump instead of editing this file."
        printf "//! Toolchain: %s.\n", version
        print ""
        print "use super::Level;"
        print ""
        print "pub(super) const LINTS: &[(&str, Level)] = &["
        for (i = 1; i <= lint_count; i++) print levels[i]
        print "];"
        print ""
        print "pub(super) const GROUPS: &[(&str, &[&str])] = &["
        for (i = 1; i <= group_count; i++) print groups[i]
        print "];"
    }
' > "$output"

rustfmt --edition 2024 "$output"
